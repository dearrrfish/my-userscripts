{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "candidateSkillHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "suiteId": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "type": "string"
    },
    "suiteHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "runnerHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "bindingHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "machineDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evaluator": {
      "minLength": 1,
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "confirmationSource": {
      "anyOf": [
        {
          "const": "coding-tool",
          "type": "string"
        },
        {
          "const": "cli",
          "type": "string"
        }
      ]
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "status": {
            "anyOf": [
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              },
              {
                "const": "pending",
                "type": "string"
              },
              {
                "const": "not-applicable",
                "type": "string"
              }
            ]
          },
          "evidence": {
            "minLength": 1,
            "type": "string"
          },
          "artifactHashes": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "mandatory",
          "status",
          "evidence",
          "artifactHashes"
        ]
      }
    },
    "reportHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evidenceDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "candidateSkillHash",
    "suiteId",
    "suiteHash",
    "runnerHash",
    "bindingHash",
    "machineDigest",
    "evaluator",
    "timestamp",
    "confirmationSource",
    "cases",
    "reportHash",
    "evidenceDigest"
  ]
}
