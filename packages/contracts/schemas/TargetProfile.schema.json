{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "type": "string"
    },
    "fm": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "range": {
          "minLength": 1,
          "type": "string"
        },
        "release": {
          "minLength": 1,
          "type": "string"
        },
        "sourceCommit": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "sourceUrl": {
          "format": "uri",
          "pattern": "^https?://",
          "type": "string"
        }
      },
      "required": [
        "version",
        "range",
        "release",
        "sourceCommit",
        "sourceUrl"
      ]
    },
    "firefox": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "range": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "range"
      ]
    },
    "help": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "url": {
          "format": "uri",
          "pattern": "^https?://",
          "type": "string"
        },
        "retrievedAt": {
          "format": "date-time",
          "type": "string"
        },
        "hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "url",
        "retrievedAt",
        "hash"
      ]
    },
    "capabilities": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "api": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "anyOf": [
                  {
                    "const": "supported",
                    "type": "string"
                  },
                  {
                    "const": "unsupported",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "contexts": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "evidence": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "properties": {
                    "kind": {
                      "anyOf": [
                        {
                          "const": "official",
                          "type": "string"
                        },
                        {
                          "const": "acceptance",
                          "type": "string"
                        },
                        {
                          "const": "fixture",
                          "type": "string"
                        }
                      ]
                    },
                    "reference": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "hash": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "description": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "reference",
                    "hash",
                    "description"
                  ]
                }
              }
            },
            "required": [
              "name",
              "status",
              "contexts",
              "evidence"
            ]
          }
        },
        "metadata": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "anyOf": [
                  {
                    "const": "supported",
                    "type": "string"
                  },
                  {
                    "const": "unsupported",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "evidence": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "properties": {
                    "kind": {
                      "anyOf": [
                        {
                          "const": "official",
                          "type": "string"
                        },
                        {
                          "const": "acceptance",
                          "type": "string"
                        },
                        {
                          "const": "fixture",
                          "type": "string"
                        }
                      ]
                    },
                    "reference": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "hash": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "description": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "reference",
                    "hash",
                    "description"
                  ]
                }
              }
            },
            "required": [
              "name",
              "status",
              "evidence"
            ]
          }
        },
        "contexts": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "required": [
        "api",
        "metadata",
        "contexts"
      ]
    },
    "lint": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "config": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {}
          }
        },
        "sourceUrl": {
          "format": "uri",
          "pattern": "^https?://",
          "type": "string"
        },
        "sourceHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "config",
        "sourceUrl",
        "sourceHash"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "fm",
    "firefox",
    "help",
    "capabilities",
    "lint"
  ]
}
