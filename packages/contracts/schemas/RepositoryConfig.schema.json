{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "outputRoot": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "targetProfile": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "type": "string"
    },
    "projects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "type": "string"
          },
          "upstream": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "local",
                    "type": "string"
                  },
                  "path": {
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ]
              },
              {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "url",
                    "type": "string"
                  },
                  "url": {
                    "format": "uri",
                    "pattern": "^https?://",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "url"
                ]
              },
              {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "git",
                    "type": "string"
                  },
                  "url": {
                    "format": "uri",
                    "pattern": "^https?://",
                    "type": "string"
                  },
                  "ref": {
                    "pattern": "^[a-f0-9]{40}$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "url",
                  "ref"
                ]
              }
            ]
          },
          "scripts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "id": {
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                  "type": "string"
                },
                "sourcePath": {
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
                  "type": "string"
                },
                "sourceManager": {
                  "anyOf": [
                    {
                      "const": "gm",
                      "type": "string"
                    },
                    {
                      "const": "vm",
                      "type": "string"
                    },
                    {
                      "const": "tm",
                      "type": "string"
                    },
                    {
                      "const": "fm",
                      "type": "string"
                    },
                    {
                      "const": "unknown",
                      "type": "string"
                    }
                  ]
                },
                "outputPath": {
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
                  "type": "string"
                },
                "identity": {
                  "additionalProperties": false,
                  "type": "object",
                  "properties": {
                    "name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "namespace": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "namespace"
                  ]
                },
                "ruleIds": {
                  "uniqueItems": true,
                  "type": "array",
                  "items": {
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                    "type": "string"
                  }
                },
                "acceptance": {
                  "additionalProperties": false,
                  "type": "object",
                  "properties": {
                    "checklistId": {
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "checklistId"
                  ]
                },
                "publish": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "properties": {
                        "mode": {
                          "const": "disabled",
                          "type": "string"
                        }
                      },
                      "required": [
                        "mode"
                      ]
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "properties": {
                        "mode": {
                          "const": "local",
                          "type": "string"
                        },
                        "baseUrl": {
                          "format": "uri",
                          "pattern": "^https?://",
                          "type": "string"
                        },
                        "licenseEvidence": {
                          "additionalProperties": false,
                          "type": "object",
                          "properties": {
                            "kind": {
                              "anyOf": [
                                {
                                  "const": "official",
                                  "type": "string"
                                },
                                {
                                  "const": "acceptance",
                                  "type": "string"
                                },
                                {
                                  "const": "fixture",
                                  "type": "string"
                                }
                              ]
                            },
                            "reference": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "hash": {
                              "pattern": "^[a-f0-9]{64}$",
                              "type": "string"
                            },
                            "description": {
                              "minLength": 1,
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "reference",
                            "hash",
                            "description"
                          ]
                        },
                        "versionMajor": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "initialRevision": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "mode",
                        "baseUrl",
                        "licenseEvidence",
                        "versionMajor",
                        "initialRevision"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "id",
                "sourceManager",
                "outputPath",
                "identity",
                "acceptance",
                "publish"
              ]
            }
          }
        },
        "required": [
          "id",
          "upstream",
          "scripts"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "outputRoot",
    "targetProfile",
    "projects"
  ]
}
